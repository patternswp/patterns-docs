{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Dark",
    "settings": {
        "color": {
            "palette": [
                {
                    "color": "#212529",
                    "name": "Base",
                    "slug": "base"
                },
                {
                    "color": "#fff",
                    "name": "Default",
                    "slug": "default"
                },
                {
                    "color": "#6C757D",
                    "name": "Primary",
                    "slug": "primary",
                    "_comment": "Lightened from #343A40 (1.5:1 contrast on base) to #6C757D for WCAG AA 4.5:1."
                },
                {
                    "color": "#DEE2E6",
                    "name": "Secondary",
                    "slug": "secondary"
                },
                {
                    "color": "#495057",
                    "name": "Tertiary",
                    "slug": "tertiary"
                },
                {
                    "color": "#868E96",
                    "name": "Quaternary",
                    "slug": "quaternary"
                },
                {
                    "_comment": "Differentiated from quaternary (#868E96) and accent (#ADB5BD).",
                    "color": "#ADB5BD",
                    "name": "Quinary",
                    "slug": "quinary"
                },
                {
                    "color": "#CED4DA",
                    "name": "Accent",
                    "slug": "accent"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|default"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var:preset|color|primary",
                    "text": "var:preset|color|default"
                },
                ":hover": {
                    "color": {
                        "background": "var:preset|color|tertiary"
                    }
                },
                ":focus": {
                    "color": {
                        "background": "var:preset|color|tertiary"
                    }
                },
                ":active": {
                    "color": {
                        "background": "var:preset|color|tertiary"
                    }
                },
                ":visited": {
                    "color": {
                        "text": "var:preset|color|base"
                    }
                }
            },
            "link": {
                ":active": {
                    "color": {
                        "text": "var:preset|color|primary"
                    }
                }
            }
        },
        "blocks": {
            "core/button": {
                "variations": {
                    "outline": {
                        "border": {
                            "color": "var(--wp--preset--color--secondary)"
                        },
                        "color": {
                            "text": "var:preset|color|secondary"
                        },
                        "elements": {
                            "link": {
                                ":hover": {
                                    "border": {
                                        "color": "var:preset|color|base"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
